# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Banco de dados ----
# Em producao (Render) defina DATABASE_URL apontando para o Postgres.
# Sem DATABASE_URL a aplicacao usa SQLite local em ./data/grupamento.db
# DATABASE_URL=postgresql://usuario:senha@host:5432/grupamento
SQLITE_PATH=./data/grupamento.db

# ---- Painel administrativo (/admin) ----
ADMIN_USER=coordenacao
ADMIN_PASSWORD=troque-esta-senha
# Segredo usado para assinar o cookie de sessao do admin (gere um valor aleatorio longo)
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio

# ---- Limites ----
# Maximo de inscricoes aceitas por IP a cada 15 minutos
RATE_LIMIT_MAX=5
